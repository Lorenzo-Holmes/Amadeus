# Keep executable sources consistent across Windows and POSIX checkouts.
*.py text eol=lf
*.toml text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
README.md text eol=lf
knowledge/data_structure.md text eol=lf
knowledge/index-policy.json text eol=lf
knowledge/manifest.json text eol=lf

# These files participate in SHA-256 identity contracts; preserve raw bytes.
outputs/*.md -text
fixtures/stage0a/*.json -text
fixtures/stage0a/generated/*.json -text
# Preserve imported legacy references byte-for-byte, including historical whitespace.
knowledge/30_research/legacy/*.md -text -whitespace
knowledge/40_history/legacy/*.md -text -whitespace

# The signed ASTER_01 v5 binaries are below GitHub's per-file limit and are
# kept directly in the release tree for a self-contained public checkout.
outputs/ASTER_01_v5_gemini_converged_20260831/model/*.glb -text
outputs/ASTER_01_v5_gemini_converged_20260831/textures/*.png -text
